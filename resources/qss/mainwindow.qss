/* 主窗口样式 */
QMainWindow {
    background-color: #f8f9fa;
}

/* 中央部件样式 */
QWidget#centralwidget {
    background-color: #f8f9fa;
}

/* 顶部工具栏样式 - 半透明白条 */
QWidget#topWidget {
    background-color: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid #e9ecef;
    padding: 8px 15px;
}

/* 时间标签样式 */
QLabel#timeLabel {
    color: #495057;
    font-size: 14px;
    font-weight: 500;
    padding: 5px 10px;
    background-color: #ffffff;
    border-radius: 6px;
    border: 1px solid #dee2e6;
}

/* 网络状态标签样式 - 图标+文字 */
QLabel#networkStatusLabel {
    font-size: 13px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 6px;
    background-color: #ffffff;
    border: 1px solid #dee2e6;
}

/* 按钮通用样式 - 圆角矩形 */
QPushButton {
    background-color: #495057;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 500;
    min-width: 70px;
}

QPushButton:hover {
    background-color: #6c757d;
    box-shadow: 0 2px 8px rgba(73, 80, 87, 0.3);
}

QPushButton:pressed {
    background-color: #343a40;
}

/* 设置按钮样式 */
QPushButton#settingButton {
    background-color: #343a40;
}

QPushButton#settingButton:hover {
    background-color: #495057;
    box-shadow: 0 2px 8px rgba(52, 58, 64, 0.3);
}

/* 窗口控制按钮样式 */
QPushButton#minimizeButton,
QPushButton#maximizeButton {
    background-color: transparent;
    color: #6c757d;
    font-size: 18px;
    min-width: 36px;
    padding: 6px;
    border-radius: 6px;
}

QPushButton#minimizeButton:hover,
QPushButton#maximizeButton:hover {
    background-color: rgba(108, 117, 125, 0.1);
    color: #343a40;
}

QPushButton#closeButton {
    background-color: transparent;
    color: #adb5bd;
    font-size: 18px;
    min-width: 36px;
    padding: 6px;
    border-radius: 6px;
}

QPushButton#closeButton:hover {
    background-color: #dc3545;
    color: white;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.3);
}

/* 左侧部件样式 - 卡片式布局 */
QWidget#leftWidget {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #dee2e6;
    margin: 8px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

/* 分组框样式 - 现代卡片式 */
QGroupBox {
    background-color: #ffffff;
    border: none;
    border-radius: 12px;
    margin-top: 15px;
    padding-top: 15px;
    font-weight: 600;
    color: #495057;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px;
    color: #495057;
    font-size: 14px;
}

/* 员工信息分组框 */
QGroupBox#infoGroupBox {
    background-color: #fafbfc;
}

QGroupBox#infoGroupBox::title {
    color: #495057;
}

/* 标签样式 */
QLabel {
    color: #495057;
    font-size: 13px;
}

/* 信息标签样式 */
QLabel#employeeIdLabel,
QLabel#nameLabel,
QLabel#statusLabel,
QLabel#checkTimeLabel {
    font-weight: 500;
    color: #6c757d;
    min-width: 75px;
}

/* 摄像头标签样式 */
QLabel#cameraLabel {
    color: #495057;
    font-size: 14px;
    font-weight: 600;
    padding: 8px;
    background-color: #ffffff;
    border-radius: 6px;
    border: 1px solid #dee2e6;
}

/* 摄像头显示区域样式 - 圆角边框，深灰色背景 */
QLabel#cameraDisplay {
    background-color: #2a2a2a;
    border: 2px solid #dee2e6;
    border-radius: 12px;
}

/* 输入框样式 - 圆角无边框，底部下划线 */
QLineEdit {
    background-color: #ffffff;
    border: none;
    border-bottom: 2px solid #dee2e6;
    border-radius: 4px;
    padding: 10px 8px;
    color: #495057;
    font-size: 14px;
}

QLineEdit:focus {
    border-bottom: 2px solid #6c757d;
    background-color: #f8f9fa;
}

QLineEdit:read-only {
    background-color: #f8f9fa;
    border-bottom: 2px solid #e9ecef;
    color: #6c757d;
}

/* 员工号输入框特殊样式 */
QLineEdit#employeeIdEdit {
    border-bottom: 2px solid #6c757d;
}

QLineEdit#employeeIdEdit:focus {
    border-bottom: 2px solid #495057;
}

/* 姓名输入框特殊样式 */
QLineEdit#nameEdit {
    border-bottom: 2px solid #6c757d;
}

QLineEdit#nameEdit:focus {
    border-bottom: 2px solid #495057;
}

/* 状态输入框特殊样式 */
QLineEdit#statusEdit {
    border-bottom: 2px solid #6c757d;
}

QLineEdit#statusEdit:focus {
    border-bottom: 2px solid #495057;
}

/* 时间输入框特殊样式 */
QLineEdit#checkTimeEdit {
    border-bottom: 2px solid #6c757d;
}

QLineEdit#checkTimeEdit:focus {
    border-bottom: 2px solid #495057;
}

/* 状态栏样式 - 半透明白条 */
QStatusBar {
    background-color: rgba(255, 255, 255, 0.95);
    color: #495057;
    border-top: 1px solid #e9ecef;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
    padding: 5px 10px;
}

/* 右侧部件样式 */
QWidget#rightWidget {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #dee2e6;
    margin: 8px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

/* 滚动条样式 */
QScrollBar:vertical {
    background-color: #f8f9fa;
    width: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #ced4da;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #adb5bd;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条 */
QScrollBar:horizontal {
    background-color: #f8f9fa;
    height: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #ced4da;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #adb5bd;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}
