/* ======================================================
   考勤打卡系统 - 深色科技风主题
   配色：背景#0d1117 / 面板#161b22 / 强调#00d4ff
   ====================================================== */

/* 主窗口 */
QMainWindow {
    background-color: #0d1117;
}

/* 中央部件 */
QWidget#centralwidget {
    background-color: #0d1117;
}

/* ==================== 顶部工具栏 ==================== */
QWidget#topWidget {
    background-color: #161b22;
    border-bottom: 1px solid #00d4ff;
    padding: 0px 4px;
}

/* 时间标签 - 白色加粗等宽字体 */
QLabel#timeLabel {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
    font-family: "Consolas", "Courier New", monospace;
    padding: 6px 14px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    letter-spacing: 1px;
}

/* 网络状态标签 */
QLabel#networkStatusLabel {
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 6px;
    background-color: #21262d;
    border: 1px solid #30363d;
}

/* ==================== 按钮 ==================== */

/* 通用按钮 */
QPushButton {
    background-color: #1f6feb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 60px;
}

QPushButton:hover {
    background-color: #388bfd;
}

QPushButton:pressed {
    background-color: #1158c7;
}

/* 设置按钮 */
QPushButton#settingButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 7px 16px;
}

QPushButton#settingButton:hover {
    background-color: #30363d;
    color: #00d4ff;
    border-color: #00d4ff;
}

QPushButton#settingButton:pressed {
    background-color: #161b22;
    color: #00d4ff;
}

/* 最小化 / 最大化按钮 */
QPushButton#minimizeButton,
QPushButton#maximizeButton {
    background-color: transparent;
    color: #8b949e;
    font-size: 16px;
    font-weight: 700;
    min-width: 36px;
    max-width: 36px;
    padding: 6px;
    border-radius: 6px;
    border: none;
}

QPushButton#minimizeButton:hover,
QPushButton#maximizeButton:hover {
    background-color: rgba(139, 148, 158, 0.15);
    color: #e6edf3;
}

QPushButton#minimizeButton:pressed,
QPushButton#maximizeButton:pressed {
    background-color: rgba(139, 148, 158, 0.25);
}

/* 关闭按钮 */
QPushButton#closeButton {
    background-color: transparent;
    color: #8b949e;
    font-size: 16px;
    font-weight: 700;
    min-width: 36px;
    max-width: 36px;
    padding: 6px;
    border-radius: 6px;
    border: none;
}

QPushButton#closeButton:hover {
    background-color: #da3633;
    color: #ffffff;
}

QPushButton#closeButton:pressed {
    background-color: #b91c1c;
    color: #ffffff;
}

/* ==================== 上层：识别信息横条 ==================== */
QWidget#infoWidget {
    background-color: #161b22;
    border-radius: 10px;
    border: 1px solid #21262d;
}

/* ==================== 标签 ==================== */

/* 通用标签 - 强制白色，防止被系统调色板覆盖 */
QLabel {
    color: #ffffff;
    font-size: 13px;
    background-color: transparent;
}

/* 信息字段描述标签（员工号、姓名等） */
QWidget#infoWidget QLabel#employeeIdLabel,
QWidget#infoWidget QLabel#nameLabel,
QWidget#infoWidget QLabel#statusLabel,
QWidget#infoWidget QLabel#checkTimeLabel {
    color: #8b949e;
    font-size: 16px;
    font-weight: 700;
    min-width: 68px;
    max-width: 80px;
    background-color: transparent;
}

/* 摄像头区域小标题 */
QLabel#cameraLabel {
    color: #adb5bd;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    background-color: transparent;
    border: none;
    padding: 2px 0px;
}

/* ==================== 输入框（只读） ==================== */
QLineEdit {
    background-color: #0d1117;
    border: none;
    border-bottom: 1px solid #30363d;
    border-radius: 3px;
    padding: 8px 6px;
    color: #e6edf3;
    font-size: 14px;
    font-weight: 500;
    selection-background-color: rgba(0, 212, 255, 0.2);
}

QLineEdit:focus {
    border-bottom: 1px solid #00d4ff;
    background-color: rgba(0, 212, 255, 0.03);
}

QLineEdit:read-only {
    background-color: #161b22;
    border-bottom: 1px solid #21262d;
    color: #c9d1d9;
    font-size: 14px;
    font-weight: 600;
}

/* ==================== 信息横条：值字段 QLabel ==================== */
QWidget#infoWidget QLabel#employeeIdEdit,
QWidget#infoWidget QLabel#nameEdit,
QWidget#infoWidget QLabel#statusEdit,
QWidget#infoWidget QLabel#checkTimeEdit {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    background-color: transparent;
    border: none;
    padding: 0px 0px;
    min-width: 60px;
    max-width: 200px;
}

/* ==================== 下层：摄像头面板 ==================== */
QWidget#cameraWidget {
    background-color: #161b22;
    border-radius: 10px;
    border: 1px solid #21262d;
    margin: 0px 0px 0px 4px;
}

/* 摄像头显示区域 - 移除边框 */
QLabel#cameraDisplay {
    background-color: #0a0e14;
    color: #30363d;
    border: none;
}



/* ==================== 滚动条 ==================== */
QScrollBar:vertical {
    background-color: #161b22;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484f58;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #161b22;
    height: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484f58;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}
